# Copy to .env and fill credentials locally. Never commit real credentials.
TUZI_API_KEY=
TUZI_API_BASE_URL=https://api.tu-zi.com
# Optional: override the video model selected by the application.
# TUZI_VIDEO_MODEL=
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=alinVoice01
# Set this to your own installed TTS helper for the local rendering workflow.
# MINIMAX_VOICE_SCRIPT=C:/path/to/minimax_voice.py
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Optional editor agent credentials and model.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# EDITOR_AGENT_MODEL=sonnet
# CHATCUT_MCP_URL=

# Optional Magpie reverse proxy for AIGC video generation. The local Magpie default is below.
# Leave blank for local mock mode; use a Magpie endpoint that exposes POST /videos.
MAGPIE_BASE_URL=http://127.0.0.1:7897/v1
MAGPIE_API_KEY=
MAGPIE_VIDEO_MODEL=seedance-2-5
# MAGPIE_VIDEO_CREATE_PATH=/videos

